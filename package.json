{
  "name": "task-shikirama2",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:executive": "npm run dev -w @shikirama/executive",
    "dev:manager": "npm run dev -w @shikirama/manager",
    "dev:employee": "npm run dev -w @shikirama/employee",
    "dev:admin": "npm run dev -w @shikirama/admin",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run prisma:generate -w @shikirama/db",
    "db:push": "npm run prisma:push -w @shikirama/db"
  }
}
