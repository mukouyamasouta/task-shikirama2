// シキラマ評価管理システム — Prisma schema
// 役員/管理者/上長/従業員 の評価フロー & 曼荼羅チャート/KGI/KPI/タスク を表現

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  EXECUTIVE   // 役員
  FULL_VIEWER // 全閲覧者
  ADMIN       // 管理者
  MANAGER     // 上長
  EMPLOYEE    // 従業員
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  ON_HOLD
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum EvaluationPeriodHalf {
  FIRST  // 上半期
  SECOND // 下半期
}

enum EvaluationStatus {
  PENDING_SELF
  PENDING_MANAGER
  PENDING_ADMIN
  PENDING_EXECUTIVE
  COMPLETED
}

model Team {
  id        String   @id @default(cuid())
  name      String   // 第1チーム / 第2チーム
  leaderId  String?  // 上長(MANAGER)
  leader    User?    @relation("TeamLeader", fields: [leaderId], references: [id])
  members   User[]   @relation("TeamMembers")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role
  teamId    String?
  team      Team?    @relation("TeamMembers", fields: [teamId], references: [id])
  leadingTeams Team[] @relation("TeamLeader")

  mandalaCharts    MandalaChart[]
  assignedTasks    Task[]         @relation("TaskAssignee")
  authoredComments Comment[]
  evaluationsAsSubject  Evaluation[] @relation("EvalSubject")
  evaluationsAsEvaluator EvaluationScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 曼荼羅チャート（中央KGI + 周囲8つのCSF）
model MandalaChart {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   // 例: 「今期売上120%達成」
  periodYear Int
  periodHalf EvaluationPeriodHalf
  kgi       Kgi?
  subGoals  SubGoal[] // 8つのCSF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Kgi {
  id              String   @id @default(cuid())
  mandalaChartId  String   @unique
  mandalaChart    MandalaChart @relation(fields: [mandalaChartId], references: [id], onDelete: Cascade)
  title           String
  targetValue     Float
  actualValue     Float    @default(0)
  achievementRate Float    @default(0) // %
}

// CSF = Critical Success Factor (曼荼羅の周囲8マス)
model SubGoal {
  id              String   @id @default(cuid())
  mandalaChartId  String
  mandalaChart    MandalaChart @relation(fields: [mandalaChartId], references: [id], onDelete: Cascade)
  position        Int      // 0..7 (左上から時計回り等)
  title           String
  achievementRate Float    @default(0)
  kpis            Kpi[]
}

model Kpi {
  id              String   @id @default(cuid())
  subGoalId       String
  subGoal         SubGoal  @relation(fields: [subGoalId], references: [id], onDelete: Cascade)
  title           String
  unit            String?
  targetValue     Float
  actualValue     Float    @default(0)
  achievementRate Float    @default(0)
  tasks           Task[]
}

model Task {
  id          String       @id @default(cuid())
  kpiId       String?
  kpi         Kpi?         @relation(fields: [kpiId], references: [id], onDelete: SetNull)
  assigneeId  String
  assignee    User         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  title       String
  status      TaskStatus   @default(NOT_STARTED)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  progressPct Int          @default(0)
  actualHours Float        @default(0)
  comments    Comment[]
  progressLogs ProgressLog[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model ProgressLog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  progressPct Int
  note      String?
  createdAt DateTime @default(now())
}

// タスク/評価への多ロールコメント
model Comment {
  id        String   @id @default(cuid())
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  evaluationId String?
  evaluation Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  authorRole Role
  body      String
  createdAt DateTime @default(now())
}

// 評価面談（半期ごと）
model Evaluation {
  id          String   @id @default(cuid())
  subjectId   String
  subject     User     @relation("EvalSubject", fields: [subjectId], references: [id])
  periodYear  Int
  periodHalf  EvaluationPeriodHalf
  status      EvaluationStatus @default(PENDING_SELF)
  scores      EvaluationScore[]
  comments    Comment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([subjectId, periodYear, periodHalf])
}

// 各ロールが付ける星(1-5)
model EvaluationScore {
  id           String @id @default(cuid())
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  evaluatorId  String
  evaluator    User       @relation(fields: [evaluatorId], references: [id])
  evaluatorRole Role
  stars        Int        // 1..5
  comment      String?
  createdAt    DateTime   @default(now())

  @@unique([evaluationId, evaluatorRole])
}
